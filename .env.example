# ==============================================================================
# Verix Environment Variables
# ==============================================================================

PROJECT_NAME=Verix
VERSION=1.0.0
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database: PostgreSQL (Render) or local SQLite fallback
# Local development default: sqlite+aiosqlite:///./verix.db
# Render PostgreSQL example: postgresql+asyncpg://user:password@hostname:5432/verix
DATABASE_URL=sqlite+aiosqlite:///./verix.db

# SerpApi Key (Reverse Image Search - Google Lens Engine)
# Obtain at: https://serpapi.com
# Keep empty in production. Enable mock responses explicitly only for local demos/tests.
SERPAPI_API_KEY=
ENABLE_MULTI_ENGINE=true
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en
SERPAPI_MAX_SECONDARY_CALLS=2

# Groq API Key (LLaMA Structured Decision Model)
# Obtain free at: https://console.groq.com
# Note: If omitted, Verix executes deterministic rule-based evaluation without LLM calls!
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
ENABLE_LLM_EVALUATION=false

# Legacy compatibility flag; it does not simulate ordinary scans.
ENABLE_MOCK_FALLBACK=false

# Required for production admin endpoints and frontend CORS.
ADMIN_API_KEY=
MEDIA_SIGNING_KEY=
ALLOWED_ORIGINS=["http://localhost:3000"]
UPLOAD_RETENTION_DAYS=7

# Public base URL if running behind a reverse proxy or tunnel (for public image URLs)
PUBLIC_BASE_URL=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=40
TRUSTED_PROXY_IPS=[]
