# ==============================================================================
# Verix — Industry-Graded .gitignore
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Local Databases & Ephemeral Storage ---
*.db
*.sqlite
*.sqlite3
verix.db
uploads/*
!uploads/.gitkeep
*.log

# --- Python Bytecode, Caches & Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
# Python build & virtual environment dirs
/lib/
/lib64/
!frontend/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test & Coverage Caches
.pytest_cache/
.uv-cache/
.deepeval/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Node.js & Next.js Artifacts ---
node_modules/
**/node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
frontend/.turbo/
.next/
out/
.turbo/

# Logs & Debuggers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm-cache/
**/.npm-cache/
.pnpm-store/
**/.pnpm-store/

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- AI & Agent Scratch Artifacts ---
scratch/
.gemini/
graphify-out/

# --- Video & Video Editing Artifacts ---
video/
demo-video/
*.mp4
*.mov
*.avi
*.mkv
*.webm

